+
+it('restores the saved main-window rectangle and re-maximizes a maximized session', async () => {
+  const home = mkdtempSync(join(tmpdir(), 'next-window-restore-'))
+  vi.stubEnv('DSH_DESKTOP_NEXT_HOME', home)
+  const userData = join(home, 'electron-user-data')
+  mkdirSync(userData, { recursive: true })
+  writeFileSync(join(userData, 'main-window-state.json'),
+    JSON.stringify({ version: 1, bounds: { x: 120, y: 80, width: 1600, height: 1000 }, maximized: true }))
+  try {
+    await import('../src/main.ts')
+    await vi.waitFor(() => expect(fixture.windows).toHaveLength(1))
+    // The fixture reports a 1920x1080 work area, so the saved rectangle fits as-is.
+    expect(fixture.windows[0].options).toMatchObject({ x: 120, y: 80, width: 1600, height: 1000 })
+    expect(fixture.windows[0].maximized).toBe(true)
+  } finally { vi.unstubAllEnvs(); rmSync(home, { recursive: true, force: true }) }
+})
+
+it('writes the main-window rectangle back after a resize so the next launch restores it', async () => {
+  const home = mkdtempSync(join(tmpdir(), 'next-window-save-'))
+  vi.stubEnv('DSH_DESKTOP_NEXT_HOME', home)
+  const statePath = join(home, 'electron-user-data', 'main-window-state.json')
+  try {
+    await import('../src/main.ts')
+    await vi.waitFor(() => expect(fixture.windows).toHaveLength(1))
+    const main = fixture.windows[0]
+    vi.useFakeTimers({ shouldClearNativeTimers: true })
+    main.setSize(1440, 900)
+    main.emit('resize')
+    vi.advanceTimersByTime(1000)
+    vi.useRealTimers()
+    expect(JSON.parse(readFileSync(statePath, 'utf8')))
+      .toMatchObject({ version: 1, maximized: false, bounds: { width: 1440, height: 900 } })
+  } finally { vi.unstubAllEnvs(); rmSync(home, { recursive: true, force: true }) }
+})
