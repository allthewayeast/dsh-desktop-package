+// 【本地覆盖层 web-access】额外受信入口的解析。
+// 格式与上游 DSH_NEXT_TRUSTED_HOSTS 一致：JSON 数组字符串（desktop-runtime 用 JSON.stringify
+// 注入、这里 JSON.parse 读取）。手写 startup.json 时也接受逗号分隔，省掉一层引号转义。
+// 以 [ 或 { 开头一律按 JSON 解析：写错时在这里就报出来，不要当成主机名继续往下传。
+function parseTrustedHostsEnv(raw: string | undefined): string[] {
+  const value = raw?.trim() ?? ''
+  if (value === '') return []
+  if (value.startsWith('[') || value.startsWith('{')) {
+    const parsed: unknown = JSON.parse(value)
+    if (!Array.isArray(parsed) || parsed.some(entry => typeof entry !== 'string')) {
+      throw new Error('Invalid DSH_WEB_TRUSTED_HOSTS: expected a JSON array of strings')
+    }
+    return (parsed as string[]).map(entry => entry.trim()).filter(entry => entry !== '')
+  }
+  return value.split(/[,;\s]+/).map(entry => entry.trim()).filter(entry => entry !== '')
+}
+
+// 【本地覆盖层 web-access】监听端口的解析。0 保留上游语义「让系统挑一个」，
+// 所以「未设置」和「显式 0」必须区分：前者回落到设置里的偏好值，后者强制自动分配。
+// 端口只能在 1–65535 里挑一个可用的，写错就在这里报出来，不要带着 NaN 往下传到 Config schema。
+function parseWebPortEnv(raw: string | undefined): number {
+  const value = raw?.trim() ?? ''
+  if (value === '') return 0
+  if (!/^\d{1,5}$/u.test(value) || Number(value) > 65_535) {
+    throw new Error('Invalid DSH_WEB_PORT: expected an integer from 0 through 65535')
+  }
+  return Number(value)
+}
