+function readPackagedCompat(context: PackagedRuntimeContext, path: string): Buffer {
+  if (!usesAsarLayout(context)) return readFileSync(join(resolvePackagedApplicationRoot(context), path))
+  try {
+    return extractFile(resolvePackagedAsarPath(context), path)
+  } catch {
+    // Windows 打包时 asar 内路径可能是反斜杠（electron-builder + @electron/asar
+    // 在 Windows 上的路径行为），或含原生模块的包被 smart unpack 整体解出到
+    // app.asar.unpacked。依次回退：先试反斜杠路径，再从 unpacked 目录读取。
+    try {
+      return extractFile(resolvePackagedAsarPath(context), path.replaceAll('/', '\\'))
+    } catch {
+      return readFileSync(join(resolvePackagedUnpackedRoot(context), path))
+    }
+  }
+}
